---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Componentes - LKMX Website</title>
	</head>
	<body class="bg-gray-50 min-h-screen font-sans">
		<header class="bg-white shadow-sm border-b">
			<div class="container mx-auto px-4 py-4">
				<nav class="flex items-center justify-between">
					<h1 class="text-2xl font-bold text-primary-600">LKMX Website</h1>
					<div class="flex space-x-4">
						<a href="/" class="text-gray-600 hover:text-primary-600 transition-colors">Inicio</a>
						<a href="/components" class="text-primary-600 font-medium">Componentes</a>
					</div>
				</nav>
			</div>
		</header>

		<main class="container mx-auto px-4 py-8">
			<div class="text-center mb-12 animate-fade-in">
				<h2 class="text-4xl font-bold text-gray-900 mb-4">Componentes de Ejemplo</h2>
				<p class="text-xl text-gray-600">Demostración de las utilidades personalizadas de Tailwind CSS</p>
			</div>

			<!-- Colores personalizados -->
			<section class="mb-12 animate-slide-up">
				<h3 class="text-2xl font-semibold text-gray-800 mb-6">Colores Personalizados</h3>
				<div class="grid grid-cols-2 md:grid-cols-5 gap-4">
					<div class="bg-primary-50 p-4 rounded-lg text-center">
						<div class="w-16 h-16 bg-primary-50 rounded-full mx-auto mb-2 border-2 border-primary-200"></div>
						<p class="text-sm font-medium text-primary-800">Primary 50</p>
					</div>
					<div class="bg-primary-100 p-4 rounded-lg text-center">
						<div class="w-16 h-16 bg-primary-100 rounded-full mx-auto mb-2 border-2 border-primary-300"></div>
						<p class="text-sm font-medium text-primary-800">Primary 100</p>
					</div>
					<div class="bg-primary-500 p-4 rounded-lg text-center">
						<div class="w-16 h-16 bg-primary-500 rounded-full mx-auto mb-2"></div>
						<p class="text-sm font-medium text-white">Primary 500</p>
					</div>
					<div class="bg-secondary-100 p-4 rounded-lg text-center">
						<div class="w-16 h-16 bg-secondary-100 rounded-full mx-auto mb-2 border-2 border-secondary-300"></div>
						<p class="text-sm font-medium text-secondary-800">Secondary 100</p>
					</div>
					<div class="bg-secondary-500 p-4 rounded-lg text-center">
						<div class="w-16 h-16 bg-secondary-500 rounded-full mx-auto mb-2"></div>
						<p class="text-sm font-medium text-white">Secondary 500</p>
					</div>
				</div>
			</section>

			<!-- Botones -->
			<section class="mb-12 animate-slide-up">
				<h3 class="text-2xl font-semibold text-gray-800 mb-6">Botones</h3>
				<div class="flex flex-wrap gap-4">
					<button class="bg-primary-500 hover:bg-primary-600 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg transform hover:-translate-y-1">
						Botón Primario
					</button>
					<button class="bg-secondary-500 hover:bg-secondary-600 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg transform hover:-translate-y-1">
						Botón Secundario
					</button>
					<button class="bg-gray-500 hover:bg-gray-600 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg transform hover:-translate-y-1">
						Botón Gris
					</button>
					<button class="border-2 border-primary-500 text-primary-500 hover:bg-primary-500 hover:text-white font-medium py-3 px-6 rounded-lg transition-all duration-200">
						Botón Outline
					</button>
				</div>
			</section>

			<!-- Cards -->
			<section class="mb-12 animate-slide-up">
				<h3 class="text-2xl font-semibold text-gray-800 mb-6">Cards</h3>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
						<div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
							<span class="text-2xl">🚀</span>
						</div>
						<h4 class="text-xl font-semibold text-gray-800 mb-2">Rendimiento</h4>
						<p class="text-gray-600 mb-4">Optimizado para velocidad y eficiencia máxima.</p>
						<button class="text-primary-600 hover:text-primary-700 font-medium">Saber más →</button>
					</div>

					<div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
						<div class="w-12 h-12 bg-secondary-100 rounded-lg flex items-center justify-center mb-4">
							<span class="text-2xl">🎨</span>
						</div>
						<h4 class="text-xl font-semibold text-gray-800 mb-2">Diseño</h4>
						<p class="text-gray-600 mb-4">Interfaces modernas y atractivas.</p>
						<button class="text-secondary-600 hover:text-secondary-700 font-medium">Saber más →</button>
					</div>

					<div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
						<div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
							<span class="text-2xl">⚡</span>
						</div>
						<h4 class="text-xl font-semibold text-gray-800 mb-2">Innovación</h4>
						<p class="text-gray-600 mb-4">Tecnologías de vanguardia.</p>
						<button class="text-purple-600 hover:text-purple-700 font-medium">Saber más →</button>
					</div>
				</div>
			</section>

			<!-- Formularios -->
			<section class="mb-12 animate-slide-up">
				<h3 class="text-2xl font-semibold text-gray-800 mb-6">Formularios</h3>
				<div class="max-w-md mx-auto">
					<form class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Nombre</label>
							<input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-200" placeholder="Tu nombre">
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
							<input type="email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-200" placeholder="tu@email.com">
						</div>
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Mensaje</label>
							<textarea rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all duration-200" placeholder="Tu mensaje"></textarea>
						</div>
						<button type="submit" class="w-full bg-primary-500 hover:bg-primary-600 text-white font-medium py-3 px-6 rounded-lg transition-all duration-200 hover:shadow-lg">
							Enviar Mensaje
						</button>
					</form>
				</div>
			</section>

			<!-- Alertas -->
			<section class="mb-12 animate-slide-up">
				<h3 class="text-2xl font-semibold text-gray-800 mb-6">Alertas</h3>
				<div class="space-y-4">
					<div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
						<div class="flex">
							<div class="flex-shrink-0">
								<span class="text-blue-400">ℹ️</span>
							</div>
							<div class="ml-3">
								<p class="text-sm text-blue-800">Esta es una alerta informativa con colores personalizados.</p>
							</div>
						</div>
					</div>
					<div class="bg-green-50 border border-green-200 rounded-lg p-4">
						<div class="flex">
							<div class="flex-shrink-0">
								<span class="text-green-400">✅</span>
							</div>
							<div class="ml-3">
								<p class="text-sm text-green-800">Operación completada exitosamente.</p>
							</div>
						</div>
					</div>
					<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
						<div class="flex">
							<div class="flex-shrink-0">
								<span class="text-yellow-400">⚠️</span>
							</div>
							<div class="ml-3">
								<p class="text-sm text-yellow-800">Advertencia: Revisa la configuración.</p>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="bg-gray-800 text-white py-8 mt-16">
			<div class="container mx-auto px-4 text-center">
				<p class="text-gray-300">© 2024 LKMX Website. Todos los derechos reservados.</p>
				<p class="text-gray-400 text-sm mt-2">Construido con Astro y Tailwind CSS</p>
			</div>
		</footer>
	</body>
</html>
